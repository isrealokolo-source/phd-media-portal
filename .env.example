# PHD Services Release Management & Rights Clearance Portal Environment Variables

# Database: PostgreSQL
DATABASE_URL="postgresql://israeluwaishe@127.0.0.1:5432/phd_portal?sslmode=disable"

# Application URL
NEXT_PUBLIC_APP_URL="https://media.phantomdigital.com.ng"

# JWT Secret for session authentication
JWT_SECRET="phd-services-secure-jwt-signing-key-production-grade-2026"

# Resend Transactional Email API Key (Leave empty to use built-in simulated transactional logger)
RESEND_API_KEY="apikey"
EMAIL_FROM="PHD Services <noreply@phantomdigital.com.ng>"

# PHD Administrative Operations Email
PHD_ADMIN_EMAIL="operations@phdservices.com"

# Storage Directory for Uploaded Masters, Cover Artwork, Legal Docs & Executed PDFs
UPLOAD_DIR="./public/uploads"

# Optional Persistent Cloud Object Storage (Cloudflare R2 / AWS S3 / DigitalOcean Spaces)
# If left empty, uploads stay stored locally on persistent disk in /public/uploads/
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="auto"
S3_ENDPOINT="" # e.g. https://<account_id>.r2.cloudflarestorage.com for Cloudflare R2
S3_PUBLIC_URL="" # e.g. https://media.phantomdigital.com.ng or https://pub-<hash>.r2.dev

